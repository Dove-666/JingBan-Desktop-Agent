{
  "manifest_version": 3,
  "name": "问问鲸鱼娘",
  "version": "1.0.0",
  "description": "选中文字后，右键问问桌面上的鲸鱼娘。仅在点击时读取当前页面的文字上下文。",
  "key": "",
  "permissions": ["contextMenus", "activeTab", "scripting", "nativeMessaging"],
  "background": {"service_worker": "service_worker.js"},
  "action": {"default_title": "问问鲸鱼娘", "default_popup": "status.html"},
  "icons": {"16": "icons/whale16.png", "48": "icons/whale48.png", "128": "icons/whale128.png"},
  "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'none'; connect-src 'none';"}
}
